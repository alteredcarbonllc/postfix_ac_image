#    -v "${CONTAINERS_ETC_GIT}/${NGINX_CONTAINER_NAME}/etc/ssl/openssl.cnf:/etc/ssl/openssl.cnf:Z" \
#    -v "${CONTAINERS_ETC_GIT}/${NGINX_CONTAINER_NAME}/usr/etc/:/usr/etc:Z" \
#    -v "${DATA_VOLUMES_DIR}/${NGINX_CONTAINER_NAME}/var/www:/var/www:Z" \
#    -v "${DATA_VOLUMES_DIR}/${NGINX_CONTAINER_NAME}/var/cache/nginx/wordpress:/var/cache/nginx/wordpress:Z" \
#    -v "${LOG_VOLUMES_DIR}/${NGINX_CONTAINER_NAME}/var/log/:/var/log/:Z" \
#    -v "${CERTS_CONTAINER_ETC_VOLUME}/etc/letsencrypt:/etc/letsencrypt:Z" \
#    -p "${NGINX_SERVER_IPV4}:80:80/tcp" \
#    -p "${NGINX_SERVER_IPV4}:80:80/udp" \
#    -p "${NGINX_SERVER_IPV4}:443:443/tcp" \
#    -p "${NGINX_SERVER_IPV4}:443:443/udp" \
#    -p "${NGINX_SERVER_IPV4}:7777:7777/tcp" \
#    -p "${NGINX_SERVER_IPV4}:7777:7777/udp" \
#    -p "${NGINX_SERVER_IPV6}:80:80/tcp" \
#    -p "${NGINX_SERVER_IPV6}:80:80/udp" \
#    -p "${NGINX_SERVER_IPV6}:443:443/tcp" \
#    -p "${NGINX_SERVER_IPV6}:443:443/udp" \
#    -p "${NGINX_SERVER_IPV6}:7777:7777/tcp" \
#    -p "${NGINX_SERVER_IPV6}:7777:7777/udp" \
#    --restart always \
#    "localhost/nginx_oqs_php_image:latest" > /tmp/podman_container_create.log 2>&1
#if [ $? -ne 0 ]; then
#    echo "Error creating container. Details:"
#    cat /tmp/podman_container_create.log
#    ask_continue
#fi

echo "Starting Ejabberd container..."
podman run -d --replace \
    --name "ejabberd_container_openmailserver.net" \
    --network "${CONTAINERS_NETWORK_NAME}" \
    --ip 10.89.1.221 \
    --ip6 fd00:10:89:1::221 \
    --mac-address 86:66:5b:a9:2f:c6 \
    -v "${CONTAINERS_ETC_GIT}/${EJABBERD_CONTAINER_NAME}/etc/ejabberd:/etc/ejabberd:Z" \
    -v "${LOG_VOLUMES_DIR}/${EJABBERD_CONTAINER_NAME}/var/log:/var/log:Z" \
    -v "${CERTS_CONTAINER_ETC_VOLUME}/etc/letsencrypt:/etc/letsencrypt:Z" \
    -v "${DATA_VOLUMES_DIR}/${EJABBERD_CONTAINER_NAME}/var/ejabberd_upload:/var/ejabberd_upload/:Z" \
    -v "${DATA_VOLUMES_DIR}/${EJABBERD_CONTAINER_NAME}/var/conversejs:/var/conversejs/:Z" \
    -p "${EJABBERD_SERVER_IPV4}:5222:5222" \
    -p "${EJABBERD_SERVER_IPV4}:5223:5223" \
    -p "${EJABBERD_SERVER_IPV4}:5269:5269" \
    -p "${EJABBERD_SERVER_IPV4}:5270:5270" \
    -p "${EJABBERD_SERVER_IPV4}:5282:5282" \
    -p "${EJABBERD_SERVER_IPV4}:5283:5283" \
    -p "${EJABBERD_SERVER_IPV4}:5349:5349" \
    -p "${EJABBERD_SERVER_IPV6}:5222:5222" \
    -p "${EJABBERD_SERVER_IPV6}:5223:5223" \
    -p "${EJABBERD_SERVER_IPV6}:5269:5269" \
    -p "${EJABBERD_SERVER_IPV6}:5270:5270" \
    -p "${EJABBERD_SERVER_IPV6}:5282:5282" \
    -p "${EJABBERD_SERVER_IPV6}:5283:5283" \
    -p "${EJABBERD_SERVER_IPV6}:5349:5349" \
    --restart always \
    "localhost/ejabberd_container:latest" > /tmp/podman_container_create.log 2>&1
if [ $? -ne 0 ]; then
    echo "Error creating container. Details:"
    cat /tmp/podman_container_create.log
    ask_continue
fi

echo "All containers launched!"
